  }

  .missing-text,
  .breakdown {
    margin: .55rem 0 0;
    font-size: .76rem;
    line-height: 1.45;
  }

  .missing-text {
    color: var(--sl-color-gray-3);
  }

  .breakdown {
    color: var(--sl-color-gray-2);
  }

  .clinical-note {
    margin-top: .9rem;
    padding: .85rem;
    border-left: 3px solid var(--sl-color-accent);
    background: var(--sl-color-gray-7);
    border-radius: .3rem .75rem .75rem .3rem;
  }

  .clinical-note strong {
    font-size: .78rem;
  }

  .clinical-note p {
