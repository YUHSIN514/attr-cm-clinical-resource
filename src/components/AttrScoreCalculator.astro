    gap: 1rem;
    align-items: flex-start;
  }

  .panel-heading h2,
  .result-heading h2 {
    margin: .1rem 0 .35rem;
    font-size: 1.2rem;
  }

  .panel-heading p,
  .result-heading p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: .9rem;
  }

